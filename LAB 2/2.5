# 0/1 Knapsack using Dynamic Programming Zosima Problem Details

def knapsack_comparison(items, capacity):
    n = len(items)

    dp = [[0] * (capacity + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        item, value, weight = items[i - 1]

        for w in range(capacity + 1):
            dp[i][w] = dp[i - 1][w]

            if weight <= w:
                dp[i][w] = max(dp[i][w],
                               value + dp[i - 1][w - weight])

    selected = []
    w = capacity

    for i in range(n, 0, -1):
        if dp[i][w] != dp[i - 1][w]:
            selected.append(items[i - 1])
            w -= items[i - 1][2]

    selected.reverse()

    total_weight = 0
    for item in selected:
        total_weight += item[2]

    fractional = sorted(
        items,
        key=lambda x: (-x[1] / x[2], x[0])
    )

    remaining = capacity
    fraction_items = []
    fraction_profit = 0
    fraction_weight = 0

    for item, value, weight in fractional:
        if remaining <= 0:
            break

        if weight <= remaining:
            fraction = 1
        else:
            fraction = remaining / weight

        profit = value * fraction
        used_weight = weight * fraction

        fraction_items.append(
            (item, value, weight, fraction, profit)
        )

        fraction_profit += profit
        fraction_weight += used_weight
        remaining -= used_weight

    result = []

    result.append("Knapsack Comparison Report")

    result.append("0/1 Knapsack")
    result.append("Selected Items")
    result.append("Item Value Weight")

    for item, value, weight in selected:
        result.append(f"{item} {value} {weight}")

    result.append(f"Maximum Value: {dp[n][capacity]}")
    result.append(f"Total Weight: {total_weight}")

    result.append("Fractional Knapsack")
    result.append("Selected Items")
    result.append("Item Value Weight Fraction Profit")

    for item, value, weight, fraction, profit in fraction_items:
        result.append(
            f"{item} {value:.2f} {weight:.2f} "
            f"{fraction:.2f} {profit:.2f}"
        )

    result.append(f"Maximum Profit: {fraction_profit:.2f}")
    result.append(f"Total Weight: {fraction_weight:.2f}")

    difference = fraction_profit - dp[n][capacity]

    result.append("Comparison")
    result.append(f"Difference: {abs(difference):.2f}")

    if difference > 0:
        better = "Fractional Knapsack"
    elif difference < 0:
        better = "0/1 Knapsack"
    else:
        better = "Both Equal"

    result.append(f"Better Result: {better}")

    result.append("Justification: Fractional Knapsack can take item fractions, while 0/1 Knapsack selects complete items only")

    return result