#  Algorithm Execution Observation Table

def generate_execution_observation_table(sizes):
  result = [
    "Algorithm Execution Observation Table",
    "InputSize RecursiveFactorial IterativeFactorial "
    "RecursiveFibonacci IterativeFibonacci LinearSearch "
    "BinarySearch BubbleSort InsertionSort"
  ]

  def fibonacci_calls(n):
    if n <= 1:
      return 1
    return 1 + fibonacci_calls(n-1) + fibonacci_calls(n-2)

  for n in sizes:
    recursive_fact = n + 1
    iterative_fact = n
    recursive_fibo = fibonacci_calls(n)
    iterative_fibo = n
    linear_search = n

    binary_search = 0
    x = n
    while x > 0:
      binary_search += 1
      x //= 2

      bubble_sort = n * (n-1) // 2
      insertion_sort = n * (n-1) // 2

    result.append(
        str(n)+" "+
        str(recursive_fact)+" "+
        str(iterative_fact)+" "+
        str(recursive_fibo)+" "+
        str(iterative_fibo)+" "+
        str(linear_search)+" "+
        str(binary_search)+" "+
        str(bubble_sort)+" "+
        str(insertion_sort)
      )
  return result