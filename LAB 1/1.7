# Complete Algorithm Performance Assessment

def complete_algorithm_performance_assessment(n, arr, target):
  def Recursive_fact(n):
    if n <= 1:
      return 1
    return n * Recursive_fact(n-1)

  def Iterative_fact(n):
    f = 1
    for i in range(1,n+1):
      f *= i
    return f

  def Recursive_fibo(n):
    if n <= 1:
      return n
    return  Recursive_fibo(n-1)+Recursive_fibo(n-2)

  def Iterative_fibo(n):
    if n <= 1:
      return n
    a, b = 0, 1
    for i in range(2,n+1):
      c = a+b
      a = b
      b = c
    return b
    
  def Linear_search(arr,target):
    comp = 0
    
    for i in range(len(arr)):
      comp += 1
      if arr[i] == target:
        return i,comp
        
    return -1,comp
  
  def Binary_search(arr,target):
    left = 0
    right = len(arr) - 1
    comp = 0

    while left <= right:
      comp += 1
      mid = (left + right) // 2
      if arr[mid] == target:
        return mid,comp
      elif arr[mid] < target:
        left = mid + 1
      else:
        right = mid - 1

    return  -1,comp
    
  def Bubble_sort(arr):
    a = arr[:]
    comp = 0
    swap = 0

    n = len(a)
    
    for i in range(n-1):
      swapped = False

      for j in range(n - 1 - i):
        comp += 1
        
        if a[j] > a[j+1]:
          temp = a[j]
          swap += 1
          a[j], a[j+1] = a[j+1], temp
          swapped = True

      if not swapped:
        break

    return a,comp,swap

  def Insertion_sort(arr):
    a = arr[:]
    comp = 0
    shift = 0

    for i in range(1,len(a)):
      key = a[i]
      j = i-1

      while j >= 0:
        comp += 1

        if a[j] > key:
          a[j+1] = a[j]
          shift += 1
          j -= 1
        else:
          break
          
      a[j+1] = key

    return a,comp,shift

  fact_rec = Recursive_fact(n)
  fact_iter = Iterative_fact(n)

  fib_rec = Recursive_fibo(n)
  fib_iter = Iterative_fibo(n)

  linear_index,linear_comp = Linear_search(arr,target)

  bubble_sorted,bubble_comp,bubble_swap = Bubble_sort(arr)
  insert_sorted,insert_comp,insert_shift = Insertion_sort(arr)
  
  binary_index,binary_comp = Binary_search(bubble_sorted,target)

  if linear_comp > binary_comp:
    search_best = "Binary Search"
  elif binary_comp > linear_comp:
    search_best = "Linear Search"
  else:
    search_best = "Both Equal"
    
  if bubble_comp > insert_comp:
    better = "Insertion Sort"
  elif insert_comp > bubble_comp:
    better = "Bubble Sort"
  else:
    better = "Both Equal"
  
  result = []
  
  result.append("Algorithm Performance Assessment")
  result.append("Computation Results")
  
  result.append("Factorial Recursive: " + str(fact_rec))
  result.append("Factorial Iterative: " + str(fact_iter))

  result.append("Fibonacci Recursive: " + str(fib_rec))
  result.append("Fibonacci Iterative: " + str(fib_iter))

  result.append("Search Results")

  result.append("Linear Index: " + str(linear_index))
  result.append("Linear Comparisons: " + str(linear_comp))

  result.append("Binary Index: " + str(binary_index))
  result.append("Binary Comparisons: " + str(binary_comp))

  result.append("Search Best: " + search_best)

  result.append("Sorting Results")
  
  result.append("Bubble Sorted: " + " ".join(map(str,bubble_sorted)))
  result.append("Bubble Comparisons: " + str(bubble_comp))
  result.append("Bubble Swaps: " + str(bubble_swap))

  result.append("Insertion Sorted: " + " ".join(map(str,insert_sorted)))
  result.append("Insertion Comparisons: " + str(insert_comp))
  result.append("Insertion Shifts: " + str(insert_shift))

  result.append("Sorting Best: " + better)

  result.append("Complexity Summary")
  result.append("Factorial: O(n)")
  result.append("Fibonacci Recursive: O(2^n)")
  result.append("Linear Search: O(n)")
  result.append("Binary Search: O(log n)")
  result.append("Bubble Sort: O(n^2)")
  result.append("Insertion Sort: O(n^2)")
  return result